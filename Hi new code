import pygame
import random
from random import randint

# Ініціалізація pygame
pygame.init()

# Параметри екрану
win_width = 600
win_height = 400
num_mines = 10  # Кількість мін
num_coins = 15   # Кількість монет

# Розміри куба і мін
cube_size = 25
mine_size = 17
coins_size = 15
enemy_size = 13

# Створення екрану
screen = pygame.display.set_mode((win_width, win_height))
pygame.display.set_caption("Сапер")

# Кольори
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 0, 0)
GREEN = (0, 255, 0)
GOLD = (255, 215, 0)
MINE_COLOR = (128, 128, 128)  # Колір мін (сірий)

# Створення поля гри
mines = []  # Список мін
coins = []  # Список монет
player_pos = [randint(0, win_width - cube_size), randint(0, win_height - cube_size)]  # Випадкове початкове положення куба
enemy_pos = [randint(0, win_width - enemy_size), randint(0, win_height - enemy_size)]  # Випадкове початкове положення ворога

class enemy():
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.speed = 0.3

    def update(self, player_pos):
        # Рухаємо ворога до гравця
        if self.x < player_pos[0]:
            self.x += self.speed
        elif self.x > player_pos[0]:
            self.x -= self.speed

        if self.y < player_pos[1]:
            self.y += self.speed    
        elif self.y > player_pos[1]:
            self.y -= self.speed

        # Перевірка на зіткнення з гравцем
        if self.x < player_pos[0] + cube_size and self.x + enemy_size > player_pos[0] and \
           self.y < player_pos[1] + cube_size and self.y + enemy_size > player_pos[1]:
            return True
        return False

# Розставлення мін
def place_mines():
    while len(mines) < num_mines:
        x = random.randint(0, win_width - mine_size)
        y = random.randint(0, win_height - mine_size)
        if (x, y) not in mines:
            mines.append((x, y))

# Розставлення монет
def place_coins():
    while len(coins) < num_coins:
        x = random.randint(0, win_width - coins_size)
        y = random.randint(0, win_height - coins_size)
        if (x, y) not in coins:
            coins.append([x, y])

# Перевірка на міну
def check_for_mine(player_pos):
    for mine in mines:
        if player_pos[0] < mine[0] + mine_size and player_pos[0] + cube_size > mine[0] and \
           player_pos[1] < mine[1] + mine_size and player_pos[1] + cube_size > mine[1]:
            return True
    return False

# Перевірка на монету
def check_for_coin(player_pos):
    global coins
    for coin in coins:
        if player_pos[0] < coin[0] + coins_size and player_pos[0] + cube_size > coin[0] and \
           player_pos[1] < coin[1] + coins_size and player_pos[1] + cube_size > coin[1]:
            coins.remove(coin)  # Забираємо монету
            return True
    return False

# Малювання гри
def draw_game():
    screen.fill(WHITE)  # Білий фон
    # Малюємо міни (сірі квадрати)
    for mine in mines:
        pygame.draw.rect(screen, MINE_COLOR, (mine[0], mine[1], mine_size, mine_size))
    # Малюємо куб (зелений)
    pygame.draw.rect(screen, GREEN, (player_pos[0], player_pos[1], cube_size, cube_size))
    # Малюємо золоті монетки
    for coin in coins:
        pygame.draw.rect(screen, GOLD, (coin[0], coin[1], coins_size, coins_size))

    # Малюємо лічильник монет
    font = pygame.font.Font(None, 36)  # Створення шрифту
    text = font.render(f"Золоті монетки: {num_coins - len(coins)}", True, GOLD)
    screen.blit(text, (10, 10))  # Малюємо текст на екрані
    # Малюємо ворога (червоний прямокутник)
    pygame.draw.rect(screen, RED, (enemy.x, enemy.y, enemy_size, enemy_size))

# Головний цикл гри
running = True
game_over = False
place_mines()
place_coins()

enemy = enemy(enemy_pos[0], enemy_pos[1])


while running:
    screen.fill(WHITE)

    draw_game()

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    if not game_over:
        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT] and player_pos[0] > 0:
            player_pos[0] -= 0.5
        if keys[pygame.K_RIGHT] and player_pos[0] < win_width - cube_size:
            player_pos[0] += 0.5
        if keys[pygame.K_UP] and player_pos[1] > 0:
            player_pos[1] -= 0.5
        if keys[pygame.K_DOWN] and player_pos[1] < win_height - cube_size:
            player_pos[1] += 0.5

        # Перевірка на міну
        if check_for_mine(player_pos):
            game_over = True

        # Перевірка на монету
        if check_for_coin(player_pos):
            print("Монетка зібрана!")

        if enemy.update(player_pos):
            game_over = True  # Гра закінчується, якщо ворог зловив гравця

    pygame.display.flip()

pygame.quit()
